{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "predictions_p13_pipeline_output_v1.schema.json",
  "title": "Pipeline output for prediction P13 (GW-EM duality Xi_0 = 1 null)",
  "$comment": "The prediction is an exact null: xi0 is const 1.0 and xi0_deviation const 0.0 by construction. Any relaxation of these constants is a framework-content change and must be registered as a superseding prediction, not edited here.",
  "type": "object",
  "required": [
    "schema",
    "prediction_id",
    "title",
    "tier",
    "tool",
    "tool_version",
    "scaling_mode",
    "prediction"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {"type": "string", "const": "predictions_p13_pipeline_output_v1"},
    "prediction_id": {"type": "string", "const": "P13"},
    "title": {"type": "string"},
    "tier": {"type": "string"},
    "tool": {"type": "string"},
    "tool_version": {"type": "string"},
    "physics_status": {"type": "string"},
    "determinism_note": {"type": "string"},
    "scaling_mode": {"type": "string", "const": "universal_coherent"},
    "prediction": {
      "type": "object",
      "required": ["distance_ratio_of_z", "xi0", "xi0_deviation"],
      "additionalProperties": true,
      "properties": {
        "distance_ratio_of_z": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["z", "dl_gw_over_dl_em"],
            "properties": {
              "z": {"type": "number", "minimum": 0},
              "dl_gw_over_dl_em": {"type": "number", "const": 1.0}
            }
          }
        },
        "xi0": {"type": "number", "const": 1.0},
        "xi0_deviation": {"type": "number", "const": 0.0},
        "parametrization_note": {"type": "string"}
      }
    },
    "framework_implications": {"type": "object"}
  }
}
