{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "predictions_p11_pipeline_output_v1.schema.json",
  "title": "Pipeline output for prediction P11 (distance-duality eta(z) = 1 null)",
  "$comment": "The prediction is an exact null: eta1_linear_coefficient and eta0_deviation are const 0.0 by construction. Any relaxation of these constants is a framework-content change and must be registered as a superseding prediction, not edited here.",
  "type": "object",
  "required": [
    "schema",
    "prediction_id",
    "title",
    "tier",
    "tool",
    "tool_version",
    "scaling_mode",
    "prediction"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {"type": "string", "const": "predictions_p11_pipeline_output_v1"},
    "prediction_id": {"type": "string", "const": "P11"},
    "title": {"type": "string"},
    "tier": {"type": "string"},
    "tool": {"type": "string"},
    "tool_version": {"type": "string"},
    "physics_status": {"type": "string"},
    "determinism_note": {"type": "string"},
    "scaling_mode": {"type": "string", "const": "universal_coherent"},
    "prediction": {
      "type": "object",
      "required": ["eta_of_z", "eta0_deviation", "eta1_linear_coefficient"],
      "additionalProperties": true,
      "properties": {
        "eta_of_z": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["z", "eta"],
            "properties": {
              "z": {"type": "number", "minimum": 0},
              "eta": {"type": "number", "const": 1.0}
            }
          }
        },
        "eta0_deviation": {"type": "number", "const": 0.0},
        "eta1_linear_coefficient": {"type": "number", "const": 0.0},
        "parametrization_note": {"type": "string"}
      }
    },
    "framework_implications": {"type": "object"}
  }
}
